<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.meditrack.ui.welcome.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_registration"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_welcome_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.meditrack.ui.registration.UserRegistrationFragment"
        android:label="Profile Setup"
        tools:layout="@layout/fragment_user_registration">
        <action
            android:id="@+id/action_registration_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.meditrack.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_schedules"
            app:destination="@id/schedulesFragment" />
        <action
            android:id="@+id/action_dashboard_to_doseHistory"
            app:destination="@id/doseFragment" />
        <action
            android:id="@+id/action_dashboard_to_scheduleDoseHistory"
            app:destination="@id/scheduleDoseHistoryFragment" />
        <action
            android:id="@+id/action_dashboard_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/schedulesFragment"
        android:name="com.example.meditrack.ui.schedules.SchedulesFragment"
        android:label="Schedules"
        tools:layout="@layout/fragment_schedules">
        <action
            android:id="@+id/action_schedules_to_details"
            app:destination="@id/scheduleDetailsFragment" />
        <action
            android:id="@+id/action_schedules_to_create"
            app:destination="@id/createScheduleFragment" />
    </fragment>

    <fragment
        android:id="@+id/scheduleDetailsFragment"
        android:name="com.example.meditrack.ui.schedules.ScheduleDetailsFragment"
        android:label="Schedule Details"
        tools:layout="@layout/fragment_schedule_details">
        <argument
            android:name="scheduleId"
            app:argType="long" />
        <action
            android:id="@+id/action_details_to_edit"
            app:destination="@id/createScheduleFragment" />
        <action
            android:id="@+id/action_details_to_history"
            app:destination="@id/scheduleDoseHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/createScheduleFragment"
        android:name="com.example.meditrack.ui.schedules.CreateScheduleFragment"
        android:label="Configure Schedule"
        tools:layout="@layout/fragment_create_schedule">
        <argument
            android:name="scheduleId"
            android:defaultValue="-1L"
            app:argType="long" />
        <action
            android:id="@+id/action_createSchedule_to_addMedicine"
            app:destination="@id/addMedicineFragment" />
    </fragment>

    <fragment
        android:id="@+id/addMedicineFragment"
        android:name="com.example.meditrack.ui.medicines.AddMedicineFragment"
        android:label="Add New Medicine"
        tools:layout="@layout/fragment_add_medicine" />

    <fragment
        android:id="@+id/doseFragment"
        android:name="com.example.meditrack.ui.dose.DoseFragment"
        android:label="Dose History"
        tools:layout="@layout/fragment_dose">
        <action
            android:id="@+id/action_dose_to_history"
            app:destination="@id/scheduleDoseHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/scheduleDoseHistoryFragment"
        android:name="com.example.meditrack.ui.dose.ScheduleDoseHistoryFragment"
        android:label="Dose Log"
        tools:layout="@layout/fragment_schedule_dose_history">
        <argument
            android:name="scheduleId"
            app:argType="long" />
        <argument
            android:name="doseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.example.meditrack.ui.reports.ReportsFragment"
        android:label="Reports"
        tools:layout="@layout/fragment_reports">
        <action
            android:id="@+id/action_reports_to_scheduleReport"
            app:destination="@id/scheduleReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/scheduleReportFragment"
        android:name="com.example.meditrack.ui.reports.ScheduleReportFragment"
        android:label="Schedule Report"
        tools:layout="@layout/fragment_schedule_report">
        <argument
            android:name="scheduleId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/caregiverInfoFragment"
        android:name="com.example.meditrack.ui.caregiver.CaregiverInfoFragment"
        android:label="Caregiver"
        tools:layout="@layout/fragment_placeholder" />

</navigation>
