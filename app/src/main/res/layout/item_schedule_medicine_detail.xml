<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <!-- Column 1: Medicine Name & Subtext (140dp) -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tv_detail_med_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                tools:text="Atorvastatin 20mg" />

            <TextView
                android:id="@+id/tv_detail_med_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/primary"
                android:textSize="11sp"
                tools:text="● Lipid Management" />

            <!-- Hidden/optional instructions placeholder for ID compatibility -->
            <TextView
                android:id="@+id/tv_detail_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Column 2: Food Requirement (100dp) -->
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/tv_detail_food_instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_default"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                tools:text="Yes (30m before)" />
        </LinearLayout>

        <!-- Column 3: Morning (80dp) -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/layout_slot_morning"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_slot_active"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_slot_morning_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_tertiary_fixed"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="✓ 08:00 AM" />
            </LinearLayout>
        </FrameLayout>

        <!-- Column 4: Afternoon (80dp) -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/layout_slot_afternoon"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_slot_box"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_slot_afternoon_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/outline"
                    android:textSize="12sp"
                    tools:text="—" />
            </LinearLayout>
        </FrameLayout>

        <!-- Column 5: Evening (80dp) -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/layout_slot_evening"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_slot_box"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_slot_evening_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/outline"
                    android:textSize="12sp"
                    tools:text="—" />
            </LinearLayout>
        </FrameLayout>

        <!-- Column 6: Night (80dp) -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/layout_slot_night"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_slot_box"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_slot_night_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/outline"
                    android:textSize="12sp"
                    tools:text="—" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Row Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant" />

</LinearLayout>
